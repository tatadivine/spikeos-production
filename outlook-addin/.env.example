# In local development leave VITE_API_BASE_URL empty so Vite proxies /api to FastAPI.
# In production set this to the public HTTPS backend, e.g. https://api.spikeos.com/api/v1
VITE_API_BASE_URL=
VITE_SPIKEOS_URL=http://localhost:5173
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
VITE_MICROSOFT_APP_ID_URI=api://YOUR_CLIENT_ID

# Production: set this to the public HTTPS Add-in origin before building the manifest.
VITE_ADDIN_URL=https://localhost:5174
VITE_SUPPORT_URL=http://localhost:5173/#/help
